# Pinned runtime component versions. Change here only; scripts and CI read this file.
BOX64_REF=v0.3.8
# Kron4ek Wine-Builds, vanilla x86-64 WoW64 build (runs 32-bit Windows programs without a 32-bit Linux userland).
WINE_VERSION=11.0
WINE_ASSET=wine-11.0-amd64-wow64.tar.xz
WINE_SHA256=39574efa1132c3ca0d5c77dd2eddbe4a49cca0d6cc2c290ff4924493a1c40314
# cnc-ddraw (MIT): DirectDraw → OpenGL. SHA-256 recorded on first CI download (run 44615062680) and pinned.
CNC_DDRAW_TAG=v7.0.0.0
CNC_DDRAW_SHA256=f9640f69c2b8c012b97720ce0a9aac483989563908fc19446b9d1ba16e7239d6
# Runtime package format/content revision; bump when the package layout or contents change.
SHC_RUNTIME_REVISION=5
# ARM64 glibc userland for the glibc loader, Box64 and Wine's native side.
# trixie (glibc 2.41): Box64 cross-built on Ubuntu 24.04 needs GLIBC_2.38/2.39; bookworm (2.36) failed in run 44619862406.
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian
# glibc rebuilt from source with runtime/glibc-android/android-seccomp.patch: unmodified Debian glibc is killed by
# Android's app seccomp filter (set_robust_list, rseq, faccessat2 — device report 2026-11-20). Upstream tarball as
# mirrored by the Ubuntu archive (orig tarball), checksum pinned.
GLIBC_VERSION=2.41
GLIBC_SRC_URL=http://archive.ubuntu.com/ubuntu/pool/main/g/glibc/glibc_2.41.orig.tar.xz
GLIBC_SRC_SHA256=a5a26b22f545d6b7d7b3dd828e11e428f24f4fac43c934fb071b6a7d0828e901
# Box64 is linked with this ELF interpreter (PT_INTERP) placeholder; the app replaces it at install time with the
# absolute path of the packaged glibc loader, so Box64 (and every process it re-executes) runs on the patched glibc.
SHC_INTERP_PLACEHOLDER=/SHC_PT_INTERP_PLACEHOLDER_________________________________________________________________________________________________________________________________________________________________________________________________________________
